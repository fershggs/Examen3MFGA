<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileActivity">

    <TextView
        android:id="@+id/tvwJugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="34dp"
        android:text="Jugador"
        app:layout_constraintEnd_toEndOf="@+id/imvImagen"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imvImagen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvwJugador"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/tvwConection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="20dp"
        android:text="última conexión"
        app:layout_constraintStart_toStartOf="@+id/imvImagen"
        app:layout_constraintTop_toBottomOf="@+id/imvImagen" />
</androidx.constraintlayout.widget.ConstraintLayout>